---
import { Picture } from "astro:assets";
import FutureLink from "./FutureLink.astro";
import { doctors, type DoctorId } from "../data/clinic";
import { portraits } from "../data/images";

// «З чим → до кого»: directions from each doctor's published profile (C-003…C-006).
const rows: { with: string; id: DoctorId }[] = [
  { with: "Втрачені зуби, імплантація, коронки й протезування", id: "pryima" },
  { with: "Біль, лікування й переліковування каналів", id: "bora" },
  { with: "Вирівнювання зубів: ортодонтія та елайнери", id: "kostenko" },
  { with: "Карієс, естетичні реставрації, гігієна та профілактика", id: "skyrchuk" },
];
---
<section id="team" class="section" aria-labelledby="team-title">
  <div class="container">
    <div class="split team__head">
      <h2 id="team-title" class="h2 split__a">До кого з чим</h2>
      <p class="muted team__lead">Лікарі PrimaDent і те, чим кожен займається.</p>
    </div>
    <ul class="team__rows" role="list">
      {rows.map((r) => {
        const d = doctors[r.id];
        return (
          <li class="split team__row" data-line>
            <p class="split__a team__with">{r.with}</p>
            <div class="split__b team__doc">
              <Picture src={portraits[r.id]} alt={`${d.name}`} formats={["avif", "webp"]} widths={[160, 240, 320, 480]}
                sizes="(min-width: 900px) 160px, 112px" loading="lazy" quality={72} class="team__photo" />
              <div class="team__info">
                <h3 class="h3 team__name">{d.name}</h3>
                <p class="small muted">{d.role}</p>
                <p class="small team__years">{d.years}</p>
              </div>
            </div>
          </li>
        );
      })}
    </ul>
    <div class="team__more">
      <FutureLink note="Розділ у розробці">Уся команда</FutureLink>
    </div>
  </div>
</section>

<style>
  .team__head { margin-bottom: clamp(2rem, 1.4rem + 2.5vw, 4rem); gap: var(--sp-4); }
  .team__lead { max-width: 40ch; }
  .team__rows { list-style: none; display: grid; }
  .team__row { padding-block: var(--sp-8); border-top: 1px solid var(--color-border); gap: var(--sp-4); }
  .team__row:last-child { border-bottom: 1px solid var(--color-border); }
  .team__with { font-family: var(--font-display); font-weight: 500; font-size: var(--fs-title); line-height: 1.25; max-width: 22ch; }
  .team__doc { display: grid; grid-template-columns: 112px minmax(0, 1fr); gap: var(--sp-6); align-items: center; }
  .team__doc :global(.team__photo) { width: 112px; height: 140px; object-fit: cover; }
  .team__info { display: grid; gap: var(--sp-1); }
  .team__name { font-size: 1.25rem; }
  .team__years { color: var(--color-accent); font-weight: 500; }
  .team__more { margin-top: var(--sp-8); }
  @media (max-width: 899px) {
    .team__row .split__b { padding-top: var(--sp-6); }
  }
  @media (min-width: 900px) {
    .team__head .team__lead { grid-column: 6 / span 7; padding-left: clamp(2rem, 1rem + 3vw, 4rem); align-self: end; }
    .team__row { align-items: center; }
    .team__doc { grid-template-columns: 160px minmax(0, 1fr); }
    .team__doc :global(.team__photo) { width: 160px; height: 200px; }
    .team__name { font-size: var(--fs-title); }
  }
</style>
