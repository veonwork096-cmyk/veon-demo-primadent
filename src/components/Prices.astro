---
import PriceRow from "./PriceRow.astro";
import FutureLink from "./FutureLink.astro";
import { priceGroups } from "../data/clinic";
---
<section id="prices" class="section section--surface" data-rec="R-008" aria-labelledby="prices-title">
  <div class="container">
    <div class="prices__head">
      <h2 id="prices-title" class="h2">Ціни</h2>
      <p class="muted prices__lead">Ціни «від» і тривалість прийому. Точну вартість лікар називає в плані лікування після консультації.</p>
    </div>
    <div class="prices__grid">
      {priceGroups.map((g) => (
        <div class="prices__group">
          <h3 class="prices__title">{g.title}</h3>
          <ul class="rows" role="list">
            {g.items.map((it) => <PriceRow item={it} />)}
          </ul>
        </div>
      ))}
    </div>
    <div class="prices__more">
      <FutureLink note="Розділ у розробці">Усі ціни та послуги</FutureLink>
    </div>
  </div>
</section>

<style>
  .prices__head { display: grid; gap: var(--sp-4); margin-bottom: clamp(2rem, 1.4rem + 2.5vw, 4rem); }
  .prices__lead { max-width: 52ch; }
  .prices__grid { display: grid; gap: var(--sp-12); }
  .prices__title { font-size: 1.1875rem; line-height: 1.3; padding-bottom: var(--sp-3); border-bottom: var(--line) solid var(--color-text); }
  .prices__more { margin-top: var(--sp-8); }
  @media (min-width: 900px) {
    .prices__head { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); align-items: end; }
    .prices__head h2 { grid-column: 1 / span 5; text-wrap: balance; }
    .prices__lead { grid-column: 6 / span 7; padding-left: clamp(2rem, 1rem + 3vw, 4rem); }
    .prices__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-flow: column; grid-template-rows: repeat(3, auto); column-gap: clamp(2rem, 1rem + 4vw, 6rem); row-gap: var(--sp-12); align-items: start; }
    .prices__group:first-child { grid-row: 1 / span 3; }
  }
</style>
