---
// Inline stroke icons (decorative; the text next to them carries the meaning).
type Name = "phone" | "telegram" | "arrow" | "arrow-up" | "pin" | "compare" | "menu" | "close" | "plus";
interface Props { name: Name; class?: string; }
const { name, class: cls = "icon" } = Astro.props;
---
<svg class={cls} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === "phone" && <path d="M5 4h3.2l1.6 4-2 1.3a11 11 0 0 0 6.9 6.9l1.3-2 4 1.6V19a1.5 1.5 0 0 1-1.6 1.5A16.5 16.5 0 0 1 3.5 5.6 1.5 1.5 0 0 1 5 4Z" />}
  {name === "telegram" && <path d="m21 4.5-3 15.2c-.2 1-.8 1.2-1.6.8l-4.5-3.3-2.2 2.1c-.2.2-.4.4-.9.4l.3-4.6 8.4-7.6c.4-.3-.1-.5-.6-.2L6.5 13.8 2 12.4c-1-.3-1-1 .2-1.4L19.7 3.3c.8-.3 1.5.2 1.3 1.2Z" />}
  {name === "arrow" && <path d="M4 12h15m-5-5 5 5-5 5" />}
  {name === "arrow-up" && <path d="M7 17 17 7m-8 0h8v8" />}
  {name === "pin" && <><path d="M12 21s-7-6.2-7-11.5a7 7 0 0 1 14 0C19 14.8 12 21 12 21Z" /><circle cx="12" cy="9.5" r="2.5" /></>}
  {name === "compare" && <path d="m9 7-5 5 5 5m6-10 5 5-5 5" />}
  {name === "menu" && <path d="M4 8h16M4 16h16" />}
  {name === "close" && <path d="m6 6 12 12M18 6 6 18" />}
  {name === "plus" && <path d="M12 5v14M5 12h14" />}
</svg>
