---
import { Picture } from "astro:assets";
import Icon from "./Icon.astro";
import FutureLink from "./FutureLink.astro";
import { clinic } from "../data/clinic";
import team from "../assets/img/team-clinic.jpg";
---
<section id="contacts" class="section contacts" data-rec="R-004" aria-labelledby="contacts-title">
  <div class="container contacts__grid">
    <div class="contacts__main">
      <h2 id="contacts-title" class="h2">Контакти</h2>
      <a class="contacts__phone figure" href={clinic.phoneHref}>{clinic.phone}</a>
      <div class="actions">
        <a class="btn btn--primary" href={clinic.phoneHref}><Icon name="phone" /><span>Зателефонувати</span></a>
        <a class="btn btn--secondary" href={clinic.telegramBot} target="_blank" rel="noopener"><Icon name="telegram" /><span>Написати в Telegram</span></a>
      </div>

      <div class="contacts__info">
        <div>
          <h3 class="contacts__label">Адреса</h3>
          <p>{clinic.addressFull}</p>
          <a class="link" href={clinic.mapHref} target="_blank" rel="noopener"><Icon name="pin" /><span>Прокласти маршрут</span></a>
        </div>
        <div>
          <h3 class="contacts__label">Графік</h3>
          <dl class="contacts__hours">
            {clinic.hours.map((h) => (<><dt>{h.days}</dt><dd class="tnum">{h.time}</dd></>))}
          </dl>
        </div>
        <div>
          <h3 class="contacts__label">Оплата</h3>
          <p>Готівка, картки Visa і Mastercard, безконтактно. Для юридичних осіб — рахунок.</p>
        </div>
      </div>
      <FutureLink note="Онлайн-запис зʼявиться в повній версії сайту">Онлайн-запис на зручний час</FutureLink>
    </div>

    <figure class="contacts__photo">
      <Picture src={team} alt="Команда PrimaDent у клініці" formats={["avif", "webp"]} widths={[400, 640, 900, 1200]}
        sizes="(min-width: 900px) 40vw, 100vw" loading="lazy" quality={70} class="contacts__img" />
    </figure>
  </div>
</section>

<style>
  .contacts__grid { display: grid; gap: var(--sp-12); }
  .contacts__main { display: grid; gap: var(--sp-8); align-content: start; }
  .contacts__phone {
    display: inline-block; justify-self: start; font-size: var(--fs-section); line-height: 1.05; font-weight: 600;
    color: var(--color-accent); text-decoration: none; white-space: nowrap;
  }
  .contacts__phone:hover { color: var(--color-accent-hover); }
  .contacts__info { display: grid; gap: var(--sp-8); }
  .contacts__info > div { display: grid; gap: var(--sp-2); align-content: start; }
  .contacts__label { font-family: var(--font-body); font-size: var(--fs-small); font-weight: 500; color: var(--color-muted); }
  .contacts__hours { display: grid; grid-template-columns: auto 1fr; gap: var(--sp-1) var(--sp-6); }
  .contacts__hours dd { margin: 0; }
  .contacts__photo :global(.contacts__img) { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: 50% 55%; }
  @media (min-width: 600px) {
    .contacts__info { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--sp-6); }
  }
  @media (min-width: 900px) {
    .contacts__grid { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); align-items: start; }
    .contacts__main { grid-column: 1 / span 7; }
    .contacts__photo { grid-column: 9 / span 4; }
  }
  @media (max-width: 380px) { .contacts__phone { font-size: 1.75rem; } }
</style>
